{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "@cloudflare/workers-types", "node"],
    "noEmit": true
  },
  "include": ["src", "shared", "worker", "vite.config.ts", "playwright.config.ts", "tests/browser"]
}
